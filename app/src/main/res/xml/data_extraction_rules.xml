<?xml version="1.0" encoding="utf-8"?>
<!-- Required from Android 12 (API 31) for backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
