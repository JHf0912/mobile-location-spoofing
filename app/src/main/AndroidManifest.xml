<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      Never granted to a normal app (signature level), but declaring it is what creates the AppOps
      entry that makes this app appear in Settings → Developer options → Select mock location app.
      Without it the picker lists every mock-location app except this one, so the setup checklist
      can never go green. Lint's "debug only" advice does not apply: injecting mock locations is
      this app's entire purpose, in release as well.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps the CPU awake while a session is injecting; a foreground service alone does not. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required by Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS in MainActivity. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Package visibility. Without this, resolveActivity() returns null on API 30+ even for these
      system settings screens, and the app silently falls through to its fallback intent instead of
      opening the one the user asked for.
    -->
    <queries>
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".SpoofingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileLocationSpoofing">

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MobileLocationSpoofing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MockLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          Quick Settings tile. exported=true and the BIND_QUICK_SETTINGS_TILE permission are both
          required for the system to bind it; nothing else can.
        -->
        <service
            android:name=".qs.MockLocationTileService"
            android:exported="true"
            android:icon="@drawable/ic_location_pin"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
