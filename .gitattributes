# Normalise line endings in the repository; check out native on each platform.
* text=auto

# Gradle wrapper must stay LF or it breaks on Unix checkouts.
gradlew text eol=lf
*.sh    text eol=lf

# Windows launchers need CRLF.
*.bat   text eol=crlf

# Binary assets — never normalise.
*.jar   binary
*.apk   binary
*.aab   binary
*.so    binary
*.dex   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ttf   binary
*.otf   binary
