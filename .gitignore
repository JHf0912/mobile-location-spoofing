# Gradle
.gradle/
build/
.kotlin/

# Android Studio / IntelliJ
# `.idea/codeStyles` is IntelliJ-only XML; code style is shared via .editorconfig instead,
# which every IDE reads. Keeping the whole directory out avoids per-machine churn.
.idea/
*.iml
captures/
.navigation/

# Local machine config — never commit (holds sdk.dir and the AMap key)
local.properties

# Signing material — never commit
keystore.properties
*.jks
*.keystore

# Build outputs
*.apk
*.aab
*.ap_
*.dex
output-metadata.json

# Logs & profiling
*.log
*.hprof

# OS noise
.DS_Store
Thumbs.db

# Local scratch space for files that belong to this machine, not to the project.
# Whatever lands here is deliberately kept out of version control.
tmp/

# Generated by Android Studio's "updateDaemonJvm" task. It pins the Gradle daemon to one JDK
# version and lets Gradle download that JDK from foojay.io when it cannot find a local match —
# a large download from a host that is slow or unreachable in mainland China. This project builds
# fine on JAVA_HOME, so the JDK requirement is documented in CONTRIBUTING.md instead.
gradle/gradle-daemon-jvm.properties
