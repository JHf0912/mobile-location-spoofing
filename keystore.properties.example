# Copy to keystore.properties (git-ignored) to produce a signed release build.
#
# Without this file the release build still succeeds, but the APK is left unsigned and
# cannot be installed on a device.
#
# Paths in storeFile are resolved relative to the app module (app/), because
# app/build.gradle.kts uses file(...). The keystore.properties file itself is read from the
# repository root.

storeFile=release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=release
keyPassword=CHANGE_ME_KEY_PASSWORD
