# Read by ktlint and by every major IDE, so code style is shared without committing
# IDE-specific XML. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,json,toml,yml,yaml}]
indent_size = 2

[*.md]
# Trailing spaces are meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false

# Windows launchers must keep CRLF to run correctly.
[*.{bat,cmd}]
end_of_line = crlf
